# ============================================================================
# NexusCore — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# NEVER commit the .env file to git.
#
# Precedence for credentials (highest first):
#   1. Server-side env var (this file)
#   2. Local storage value injected by the client (offline mode)
#   3. Empty / unset
# ============================================================================

# ── App mode ────────────────────────────────────────────────────────────
NODE_ENV=development
# "offline_local" or "cloud_sync" — controls whether the UI talks to Supabase
OPERATION_MODE=offline_local

# ── Supabase (cloud sync mode) ──────────────────────────────────────────
# Get these from your Supabase project → Settings → API.
# The anon key is safe for the browser; the service role key MUST stay on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ character random string. Used to sign session tokens.
AUTH_JWT_SECRET=change-me-to-a-random-32-plus-character-string
# Internal API key for trusted server-to-server calls (e.g. webhooks).
INTERNAL_API_KEY=

# ── License (Phase D hardening) ────────────────────────────────────────
# Server-side secret used to sign LicenseRecord integrity signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, the client falls back to a built-in dev constant
# (acceptable for offline-first dev; production should always set this).
LICENSE_SIGNING_SECRET=

# ── Paymob (payment gateway) ────────────────────────────────────────────
# Get these from the Paymob dashboard → Settings → API Keys / Webhooks.
# PAYMOB_INTEGRATION_ID is the Card / Wallet / Kiosk processing integration.
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# The URL Paymob will POST to after a transaction completes. Set this to:
#   https://<project-ref>.functions.supabase.co/handle-paymob-webhook
PAYMOB_CALLBACK_URL=

# ── Shipping carriers ───────────────────────────────────────────────────
# SHIPPING_API_KEY is the carrier-issued secret for the chosen provider.
# SHIPPING_STORE_ID is the merchant identifier (Bosta uses this).
# SHIPPING_WEBHOOK_SECRET is the HMAC secret for verifying inbound tracking updates.
SHIPPING_API_KEY=
SHIPPING_STORE_ID=
SHIPPING_WEBHOOK_SECRET=
# The URL the carrier will POST tracking updates to. Set this to:
#   https://<project-ref>.functions.supabase.co/handle-shipping-webhook
SHIPPING_WEBHOOK_URL=
# One of: sandbox | production
SHIPPING_ENVIRONMENT=sandbox

# ── Online order intake (storefront) ────────────────────────────────────
# Used for Shopify, WooCommerce, or a custom webstore.
ONLINE_ORDER_API_KEY=
ONLINE_ORDER_API_SECRET=
ONLINE_ORDER_HMAC_SECRET=
# The URL the storefront will POST new orders to. Set this to:
#   https://<project-ref>.functions.supabase.co/handle-ecommerce-order
ONLINE_ORDER_WEBHOOK_URL=
# The base URL of the storefront (used for status update callbacks).
ONLINE_ORDER_STORE_URL=

# ── Misc ────────────────────────────────────────────────────────────────
# The default wallet for routing online-order revenue when none is specified.
DEFAULT_WALLET=inStoreSafe
